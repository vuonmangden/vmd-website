generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(30)
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String   @map("resource_id") @db.Uuid
  beforeData    Json?    @map("before_data") @db.JsonB
  afterData     Json?    @map("after_data") @db.JsonB
  reason        String?  @db.Text
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent") @db.Text
  correlationId String?  @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  key            String   @id @db.VarChar(180)
  scope          String   @db.VarChar(80)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json      @db.JsonB
  status        String    @default("pending") @db.VarChar(30)
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode      String    @unique @map("customer_code") @db.VarChar(30)
  fullName          String    @map("full_name") @db.VarChar(150)
  phoneNormalized   String?   @map("phone_normalized") @db.VarChar(20)
  emailNormalized   String?   @map("email_normalized") @db.Citext
  source            String    @default("DIRECT") @db.VarChar(50)
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  privacyConsentAt  DateTime? @map("privacy_consent_at") @db.Timestamptz()
  notes             String?   @db.Text
  firstBookingAt    DateTime? @map("first_booking_at") @db.Timestamptz()
  lastBookingAt     DateTime? @map("last_booking_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  bookings          Booking[]
  bbqReservations   BbqReservation[]
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@map("customers")
}

model Booking {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingCode  String       @unique @map("booking_code") @db.VarChar(30)
  customerId   String       @map("customer_id") @db.Uuid
  checkInDate  DateTime     @map("check_in_date") @db.Date
  checkOutDate DateTime     @map("check_out_date") @db.Date
  adults       Int
  children     Int          @default(0)
  status       String       @db.VarChar(40)
  source       String       @db.VarChar(50)
  totalAmount  BigInt       @map("total_amount")
  depositRequiredAmount BigInt @default(0) @map("deposit_required_amount")
  depositPolicy String      @default("STANDARD_50") @map("deposit_policy") @db.VarChar(30)
  originalCheckInDate DateTime? @map("original_check_in_date") @db.Date
  originalCheckOutDate DateTime? @map("original_check_out_date") @db.Date
  dateChangeCount Int       @default(0) @map("date_change_count")
  specialRequest String?    @map("special_request") @db.Text
  expectedArrivalTime String? @map("expected_arrival_time") @db.VarChar(50)
  currency     String       @default("VND") @db.Char(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rooms        BookingRoom[]
  occupancies  RoomOccupancy[]
  statusHistory BookingStatusHistory[]
  paymentIntents PaymentIntent[]
  guestRequests BookingGuestRequest[]
  @@index([status, checkInDate])
  @@map("bookings")
}

model BookingGuestRequest {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  requestType     String   @map("request_type") @db.VarChar(30)
  status          String   @default("PENDING_REVIEW") @db.VarChar(30)
  requestedData   Json     @map("requested_data") @db.JsonB
  guestNote       String?  @map("guest_note") @db.Text
  receptionNote   String?  @map("reception_note") @db.Text
  reviewedBy      String?  @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz()
  decidedBy       String?  @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz()
  decisionNote    String?  @map("decision_note") @db.Text
  refundPolicy    String?  @map("refund_policy") @db.VarChar(20)
  refundTierCode  String?  @map("refund_tier_code") @db.VarChar(50)
  refundPercent   Int?     @map("refund_percent")
  refundAmount    BigInt?  @map("refund_amount")
  forfeitedAmount BigInt?  @map("forfeited_amount")
  previousTotalAmount BigInt? @map("previous_total_amount")
  recalculatedTotalAmount BigInt? @map("recalculated_total_amount")
  chargedTotalAmount BigInt? @map("charged_total_amount")
  additionalAmountDue BigInt? @map("additional_amount_due")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, status, createdAt])
  @@map("booking_guest_requests")
}

model PaymentIntent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String?  @map("booking_id") @db.Uuid
  bbqReservationId String? @map("bbq_reservation_id") @db.Uuid
  provider        String   @default("SEPAY_TEST") @db.VarChar(50)
  status          String   @default("PENDING") @db.VarChar(30)
  amount          BigInt
  paidAmount      BigInt   @default(0) @map("paid_amount")
  currency        String   @default("VND") @db.Char(3)
  transferContent String   @unique @map("transfer_content") @db.VarChar(25)
  qrPayload       String   @map("qr_payload") @db.Text
  expiresAt       DateTime @map("expires_at") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bbqReservation  BbqReservation? @relation(fields: [bbqReservationId], references: [id], onDelete: Restrict)
  reconciliationCases ReconciliationCase[]

  @@index([status, expiresAt])
  @@index([bookingId, status])
  @@index([bbqReservationId, status])
  @@map("payment_intents")
}

model PaymentWebhookEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String   @db.VarChar(30)
  providerEventId String   @map("provider_event_id") @db.VarChar(150)
  providerTransactionId String @map("provider_transaction_id") @db.VarChar(150)
  signatureValid  Boolean  @map("signature_valid")
  payload         Json     @db.JsonB
  headers         Json     @db.JsonB
  processingStatus String  @default("RECEIVED") @map("processing_status") @db.VarChar(30)
  attemptCount    Int      @default(0) @map("attempt_count")
  errorMessage    String?  @map("error_message") @db.Text
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz()
  processedAt     DateTime? @map("processed_at") @db.Timestamptz()

  @@unique([provider, providerEventId])
  @@unique([provider, providerTransactionId])
  @@index([processingStatus, receivedAt])
  @@map("payment_webhook_events")
}

model ReconciliationCase {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentIntentId   String    @map("payment_intent_id") @db.Uuid
  status            String    @default("OPEN") @db.VarChar(30)
  reason            String    @db.VarChar(100)
  expectedAmount    BigInt    @map("expected_amount")
  receivedAmount    BigInt    @map("received_amount")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz()
  resolvedBy        String?   @map("resolved_by") @db.Uuid
  resolutionOutcome String?   @map("resolution_outcome") @db.VarChar(30)
  resolutionNote    String?   @map("resolution_note") @db.Text
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("reconciliation_cases")
}

model BookingStatusHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(40)
  toStatus   String   @map("to_status") @db.VarChar(40)
  reason     String?  @db.Text
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz()
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([bookingId, changedAt])
  @@map("booking_status_history")
}

model BookingRoom {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String   @map("booking_id") @db.Uuid
  roomId              String   @map("room_id") @db.Uuid
  roomTypeId          String   @map("room_type_id") @db.Uuid
  nightlyRateSnapshot Json     @map("nightly_rate_snapshot")
  amount              BigInt
  adults              Int
  children            Int      @default(0)
  extraMattressQuantity Int    @default(0) @map("extra_mattress_quantity")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  room                Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  roomType            RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  @@index([bookingId])
  @@map("booking_rooms")
}

model RoomType {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(150)
  slug            String    @unique @db.VarChar(180)
  shortDescription String?  @map("short_description") @db.Text
  description     String?   @db.Text
  standardAdults  Int       @map("standard_adults")
  maxAdults       Int       @map("max_adults")
  maxChildren     Int       @default(0) @map("max_children")
  maxTotalGuests  Int       @map("max_total_guests")
  bedConfiguration Json     @default("[]") @map("bed_configuration") @db.JsonB
  amenities       Json     @default("[]") @db.JsonB
  status          String   @default("DRAFT") @db.VarChar(30)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  rooms           Room[]
  rateRules       RoomRateRule[]
  bookingRooms    BookingRoom[]

  @@index([status, sortOrder])
  @@map("room_types")
}

model RoomRateRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomTypeId      String   @map("room_type_id") @db.Uuid
  name            String   @db.VarChar(150)
  dateFrom        DateTime @map("date_from") @db.Date
  dateTo          DateTime @map("date_to") @db.Date
  daysOfWeek      Int[]    @default([]) @map("days_of_week")
  nightlyPrice    BigInt   @map("nightly_price")
  extraAdultPrice BigInt   @default(0) @map("extra_adult_price")
  extraChildPrice BigInt   @default(0) @map("extra_child_price")
  minNights       Int      @default(1) @map("min_nights")
  maxNights       Int?     @map("max_nights")
  priority        Int      @default(0)
  status          String   @default("DRAFT") @db.VarChar(30)
  rateType        String   @default("STANDARD") @map("rate_type") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@index([roomTypeId, status, priority])
  @@map("room_rate_rules")
}

model Room {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomTypeId       String    @map("room_type_id") @db.Uuid
  code             String    @unique @db.VarChar(50)
  name             String    @db.VarChar(100)
  floor            String?   @db.VarChar(50)
  areaZone         String?   @map("area_zone") @db.VarChar(100)
  status           String    @default("INACTIVE") @db.VarChar(30)
  maintenanceNotes String?   @map("maintenance_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  roomType         RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  blocks           RoomBlock[]
  occupancies      RoomOccupancy[]
  bookingRooms     BookingRoom[]

  @@index([roomTypeId, status])
  @@map("rooms")
}

model RoomOccupancy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  stayDate  DateTime @map("stay_date") @db.Date
  status    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@unique([roomId, stayDate])
  @@index([bookingId])
  @@map("room_occupancies")
}

model ResourceHold {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceType   String    @map("resource_type") @db.VarChar(30)
  resourceId     String    @map("resource_id") @db.Uuid
  referenceType  String    @map("reference_type") @db.VarChar(30)
  referenceId    String    @map("reference_id") @db.Uuid
  startAt        DateTime  @map("start_at") @db.Timestamptz()
  endAt          DateTime  @map("end_at") @db.Timestamptz()
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  status         String    @db.VarChar(30)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(150)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz()
  releasedAt     DateTime? @map("released_at") @db.Timestamptz()
  @@index([resourceType, resourceId, status, expiresAt])
  @@map("resource_holds")
}

model RoomBlock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  reason      String    @db.Text
  blockType   String    @map("block_type") @db.VarChar(30)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz()

  room      Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  creator   StaffProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([roomId, startDate, endDate])
  @@map("room_blocks")
}

model StaffProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(150)
  email       String   @db.Citext
  status      String   @default("INVITED") @db.VarChar(30)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roomBlocksCreated RoomBlock[]

  roleAssignments         StaffRoleAssignment[] @relation("StaffRoles")
  assignedRoleAssignments StaffRoleAssignment[] @relation("RoleAssignedBy")

  @@map("staff_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  permissions RolePermission[]
  assignments StaffRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model StaffRoleAssignment {
  staffId   String   @map("staff_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  staff      StaffProfile  @relation("StaffRoles", fields: [staffId], references: [id], onDelete: Cascade)
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   StaffProfile? @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([staffId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("staff_role_assignments")
}

model NotificationJob {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateCode         String    @map("template_code") @db.VarChar(80)
  recipientType        String    @map("recipient_type") @db.VarChar(30)
  recipientReferenceId String    @map("recipient_reference_id") @db.Uuid
  email                String?   @db.Citext
  phone                String?   @db.VarChar(20)
  payload              Json      @db.JsonB
  scheduledAt          DateTime  @map("scheduled_at") @db.Timestamptz()
  status               String    @default("pending") @db.VarChar(30)
  deduplicationKey     String    @unique @map("deduplication_key") @db.VarChar(180)
  attemptCount         Int       @default(0) @map("attempt_count")
  lastError            String?   @map("last_error") @db.Text
  claimToken           String?   @map("claim_token") @db.Uuid
  processingStartedAt  DateTime? @map("processing_started_at") @db.Timestamptz()
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt          DateTime? @map("completed_at") @db.Timestamptz()

  deliveries NotificationDelivery[]

  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@map("notification_jobs")
}

model NotificationDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  channel           String    @db.VarChar(30)
  provider          String    @db.VarChar(50)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(150)
  status            String    @default("pending") @db.VarChar(30)
  responseData      Json?     @map("response_data") @db.JsonB
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz()
  failedAt          DateTime? @map("failed_at") @db.Timestamptz()

  job NotificationJob @relation(fields: [jobId], references: [id])

  @@map("notification_deliveries")
}

model BbqMenuItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @unique @db.VarChar(80)
  name              String   @db.VarChar(200)
  menuGroup         String   @map("menu_group") @db.VarChar(50)
  unit              String   @db.VarChar(20)
  price             BigInt
  publicDescription String?  @map("public_description") @db.Text
  internalNote      String?  @map("internal_note") @db.Text
  isAvailable       Boolean  @default(true) @map("is_available")
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([menuGroup, displayOrder])
  @@map("bbq_menu_items")
}

model BbqCombo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(80)
  name         String   @db.VarChar(200)
  price        BigInt
  minGuests    Int?     @map("min_guests")
  maxGuests    Int?     @map("max_guests")
  composition  String?  @db.Text
  internalNote String?  @map("internal_note") @db.Text
  isAvailable  Boolean  @default(true) @map("is_available")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([displayOrder])
  @@map("bbq_combos")
}

model BbqArea {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String    @unique @db.VarChar(50)
  name          String    @db.VarChar(150)
  description   String?   @db.Text
  minCapacity   Int       @map("min_capacity")
  maxCapacity   Int       @map("max_capacity")
  coverMediaId  String?   @map("cover_media_id") @db.Uuid
  status        String    @default("ACTIVE") @db.VarChar(30)
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  tables       BbqTable[]
  serviceSlots BbqServiceSlot[]
  reservationTables BbqReservationTable[]

  @@index([status, sortOrder])
  @@map("bbq_areas")
}

model BbqTable {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  areaId             String    @map("area_id") @db.Uuid
  code               String    @unique @db.VarChar(50)
  name               String    @db.VarChar(100)
  minCapacity        Int       @map("min_capacity")
  maxCapacity        Int       @map("max_capacity")
  status             String    @default("ACTIVE") @db.VarChar(30)
  turnaroundMinutes  Int       @default(30) @map("turnaround_minutes")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()

  area BbqArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  reservationTables BbqReservationTable[]

  @@index([areaId, status])
  @@map("bbq_tables")
}

model BbqServiceSlot {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  areaId                  String?   @map("area_id") @db.Uuid
  name                    String    @db.VarChar(100)
  startTime               String    @map("start_time") @db.VarChar(5)
  endTime                 String    @map("end_time") @db.VarChar(5)
  bookingIntervalMinutes  Int?      @map("booking_interval_minutes")
  maxTotalGuests          Int?      @map("max_total_guests")
  daysOfWeek              Int[]     @default([]) @map("days_of_week")
  dateFrom                DateTime? @map("date_from") @db.Date
  dateTo                  DateTime? @map("date_to") @db.Date
  status                  String    @default("ACTIVE") @db.VarChar(30)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  area BbqArea? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("bbq_service_slots")
}

model BbqReservation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationCode String    @unique @map("reservation_code") @db.VarChar(30)
  customerId      String    @map("customer_id") @db.Uuid
  reservationDate DateTime  @map("reservation_date") @db.Date
  startTime       String    @map("start_time") @db.VarChar(5)
  endTime         String    @map("end_time") @db.VarChar(5)
  adults          Int
  children        Int       @default(0)
  status          String    @db.VarChar(30)
  source          String    @db.VarChar(50)
  itemsAmount     BigInt    @default(0) @map("items_amount")
  depositAmount   BigInt    @map("deposit_amount")
  currency        String    @default("VND") @db.Char(3)
  specialRequest  String?   @map("special_request") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  customer      Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  tables        BbqReservationTable[]
  items         BbqReservationItem[]
  statusHistory BbqReservationStatusHistory[]
  paymentIntents PaymentIntent[]

  @@index([status, reservationDate])
  @@map("bbq_reservations")
}

model BbqReservationTable {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  tableId       String   @map("table_id") @db.Uuid
  areaId        String   @map("area_id") @db.Uuid
  startAt       DateTime @map("start_at") @db.Timestamptz()
  endAt         DateTime @map("end_at") @db.Timestamptz()
  status        String   @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  reservation BbqReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  table       BbqTable       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  area        BbqArea        @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([tableId, status])
  @@map("bbq_reservation_tables")
}

model BbqReservationItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  itemType      String   @map("item_type") @db.VarChar(20)
  code          String   @db.VarChar(80)
  nameSnapshot  String   @map("name_snapshot") @db.VarChar(200)
  unitSnapshot  String?  @map("unit_snapshot") @db.VarChar(20)
  unitPrice     BigInt   @map("unit_price")
  quantity      Int
  lineTotal     BigInt   @map("line_total")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  reservation BbqReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("bbq_reservation_items")
}

model BbqReservationStatusHistory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  fromStatus    String?  @map("from_status") @db.VarChar(30)
  toStatus      String   @map("to_status") @db.VarChar(30)
  reason        String?  @db.Text
  changedAt     DateTime @default(now()) @map("changed_at") @db.Timestamptz()

  reservation BbqReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId, changedAt])
  @@map("bbq_reservation_status_history")
}

model ContentPage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String    @unique @db.VarChar(150)
  title       String    @db.VarChar(200)
  body        String    @db.Text
  status      String    @default("DRAFT") @db.VarChar(20)
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([status, slug])
  @@map("content_pages")
}

model MediaAsset {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket       String    @db.VarChar(100)
  objectKey    String    @map("object_key") @db.Text
  originalName String    @map("original_name") @db.Text
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt?   @map("size_bytes")
  width        Int?
  height       Int?
  altText      String?   @map("alt_text") @db.Text
  visibility   String    @default("PUBLIC") @db.VarChar(30)
  status       String    @default("PENDING") @db.VarChar(20)
  uploadedBy   String?   @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  @@unique([bucket, objectKey])
  @@index([status, deletedAt])
  @@map("media_assets")
}

model ArticleCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  articles Article[]

  @@index([status, sortOrder])
  @@map("article_categories")
}

model Article {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  title          String    @db.VarChar(250)
  slug           String    @unique @db.VarChar(250)
  excerpt        String?   @db.Text
  content        Json      @db.JsonB
  coverMediaId   String?   @map("cover_media_id") @db.Uuid
  authorId       String?   @map("author_id") @db.Uuid
  status         String    @default("DRAFT") @db.VarChar(20)
  seoTitle       String?   @map("seo_title") @db.VarChar(200)
  seoDescription String?   @map("seo_description") @db.VarChar(300)
  canonicalUrl   String?   @map("canonical_url") @db.Text
  publishedAt    DateTime? @map("published_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@map("articles")
}

model AppSetting {
  key               String   @id @db.VarChar(150)
  value             Json     @db.JsonB
  category          String   @db.VarChar(80)
  isSecretReference Boolean  @default(false) @map("is_secret_reference")
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_settings")
}

