generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(30)
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String   @map("resource_id") @db.Uuid
  beforeData    Json?    @map("before_data") @db.JsonB
  afterData     Json?    @map("after_data") @db.JsonB
  reason        String?  @db.Text
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent") @db.Text
  correlationId String?  @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  key            String   @id @db.VarChar(180)
  scope          String   @db.VarChar(80)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json      @db.JsonB
  status        String    @default("pending") @db.VarChar(30)
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode      String    @unique @map("customer_code") @db.VarChar(30)
  fullName          String    @map("full_name") @db.VarChar(150)
  phoneNormalized   String?   @map("phone_normalized") @db.VarChar(20)
  emailNormalized   String?   @map("email_normalized") @db.Citext
  source            String    @default("DIRECT") @db.VarChar(50)
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  privacyConsentAt  DateTime? @map("privacy_consent_at") @db.Timestamptz()
  notes             String?   @db.Text
  firstBookingAt    DateTime? @map("first_booking_at") @db.Timestamptz()
  lastBookingAt     DateTime? @map("last_booking_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@map("customers")
}

model RoomType {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(50)
  name            String    @db.VarChar(150)
  slug            String    @unique @db.VarChar(180)
  shortDescription String?  @map("short_description") @db.Text
  description     String?   @db.Text
  standardAdults  Int       @map("standard_adults")
  maxAdults       Int       @map("max_adults")
  maxChildren     Int       @default(0) @map("max_children")
  maxTotalGuests  Int       @map("max_total_guests")
  bedConfiguration Json     @default("[]") @map("bed_configuration") @db.JsonB
  amenities       Json     @default("[]") @db.JsonB
  status          String   @default("DRAFT") @db.VarChar(30)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz()

  rooms           Room[]
  rateRules       RoomRateRule[]

  @@index([status, sortOrder])
  @@map("room_types")
}

model RoomRateRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomTypeId      String   @map("room_type_id") @db.Uuid
  name            String   @db.VarChar(150)
  dateFrom        DateTime @map("date_from") @db.Date
  dateTo          DateTime @map("date_to") @db.Date
  daysOfWeek      Int[]    @default([]) @map("days_of_week")
  nightlyPrice    BigInt   @map("nightly_price")
  extraAdultPrice BigInt   @default(0) @map("extra_adult_price")
  extraChildPrice BigInt   @default(0) @map("extra_child_price")
  minNights       Int      @default(1) @map("min_nights")
  maxNights       Int?     @map("max_nights")
  priority        Int      @default(0)
  status          String   @default("DRAFT") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@index([roomTypeId, status, priority])
  @@map("room_rate_rules")
}

model Room {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomTypeId       String    @map("room_type_id") @db.Uuid
  code             String    @unique @db.VarChar(50)
  name             String    @db.VarChar(100)
  floor            String?   @db.VarChar(50)
  areaZone         String?   @map("area_zone") @db.VarChar(100)
  status           String    @default("INACTIVE") @db.VarChar(30)
  maintenanceNotes String?   @map("maintenance_notes") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz()

  roomType         RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  blocks           RoomBlock[]
  occupancies      RoomOccupancy[]

  @@index([roomTypeId, status])
  @@map("rooms")
}

model RoomOccupancy {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  stayDate  DateTime @map("stay_date") @db.Date
  status    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  @@unique([roomId, stayDate])
  @@index([bookingId])
  @@map("room_occupancies")
}

model ResourceHold {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceType   String    @map("resource_type") @db.VarChar(30)
  resourceId     String    @map("resource_id") @db.Uuid
  referenceType  String    @map("reference_type") @db.VarChar(30)
  referenceId    String    @map("reference_id") @db.Uuid
  startAt        DateTime  @map("start_at") @db.Timestamptz()
  endAt          DateTime  @map("end_at") @db.Timestamptz()
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz()
  status         String    @db.VarChar(30)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(150)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz()
  releasedAt     DateTime? @map("released_at") @db.Timestamptz()
  @@index([resourceType, resourceId, status, expiresAt])
  @@map("resource_holds")
}

model RoomBlock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String    @map("room_id") @db.Uuid
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime  @map("end_date") @db.Date
  reason      String    @db.Text
  blockType   String    @map("block_type") @db.VarChar(30)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz()

  room      Room         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  creator   StaffProfile @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([roomId, startDate, endDate])
  @@map("room_blocks")
}

model StaffProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(150)
  email       String   @db.Citext
  status      String   @default("INVITED") @db.VarChar(30)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  roomBlocksCreated RoomBlock[]

  roleAssignments         StaffRoleAssignment[] @relation("StaffRoles")
  assignedRoleAssignments StaffRoleAssignment[] @relation("RoleAssignedBy")

  @@map("staff_profiles")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  permissions RolePermission[]
  assignments StaffRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model StaffRoleAssignment {
  staffId   String   @map("staff_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedBy String? @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()

  staff      StaffProfile  @relation("StaffRoles", fields: [staffId], references: [id], onDelete: Cascade)
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner   StaffProfile? @relation("RoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([staffId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("staff_role_assignments")
}

model NotificationJob {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateCode         String    @map("template_code") @db.VarChar(80)
  recipientType        String    @map("recipient_type") @db.VarChar(30)
  recipientReferenceId String    @map("recipient_reference_id") @db.Uuid
  email                String?   @db.Citext
  phone                String?   @db.VarChar(20)
  payload              Json      @db.JsonB
  scheduledAt          DateTime  @map("scheduled_at") @db.Timestamptz()
  status               String    @default("pending") @db.VarChar(30)
  deduplicationKey     String    @unique @map("deduplication_key") @db.VarChar(180)
  attemptCount         Int       @default(0) @map("attempt_count")
  lastError            String?   @map("last_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  completedAt          DateTime? @map("completed_at") @db.Timestamptz()

  deliveries NotificationDelivery[]

  @@index([status, scheduledAt])
  @@map("notification_jobs")
}

model NotificationDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  channel           String    @db.VarChar(30)
  provider          String    @db.VarChar(50)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(150)
  status            String    @default("pending") @db.VarChar(30)
  responseData      Json?     @map("response_data") @db.JsonB
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz()
  failedAt          DateTime? @map("failed_at") @db.Timestamptz()

  job NotificationJob @relation(fields: [jobId], references: [id])

  @@map("notification_deliveries")
}

model AppSetting {
  key               String   @id @db.VarChar(150)
  value             Json     @db.JsonB
  category          String   @db.VarChar(80)
  isSecretReference Boolean  @default(false) @map("is_secret_reference")
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_settings")
}
