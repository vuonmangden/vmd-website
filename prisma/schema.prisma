generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(30)
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String   @map("resource_id") @db.Uuid
  beforeData    Json?    @map("before_data") @db.JsonB
  afterData     Json?    @map("after_data") @db.JsonB
  reason        String?  @db.Text
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent") @db.Text
  correlationId String?  @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  key            String   @id @db.VarChar(180)
  scope          String   @db.VarChar(80)
  requestHash    String   @map("request_hash") @db.VarChar(128)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  expiresAt      DateTime @map("expires_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(80)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json      @db.JsonB
  status        String    @default("pending") @db.VarChar(30)
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode      String    @unique @map("customer_code") @db.VarChar(30)
  fullName          String    @map("full_name") @db.VarChar(150)
  phoneNormalized   String?   @map("phone_normalized") @db.VarChar(20)
  emailNormalized   String?   @map("email_normalized") @db.Citext
  source            String    @default("DIRECT") @db.VarChar(50)
  marketingConsent  Boolean   @default(false) @map("marketing_consent")
  privacyConsentAt  DateTime? @map("privacy_consent_at") @db.Timestamptz()
  notes             String?   @db.Text
  firstBookingAt    DateTime? @map("first_booking_at") @db.Timestamptz()
  lastBookingAt     DateTime? @map("last_booking_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()

  @@index([phoneNormalized])
  @@index([emailNormalized])
  @@map("customers")
}

model AppSetting {
  key               String   @id @db.VarChar(150)
  value             Json     @db.JsonB
  category          String   @db.VarChar(80)
  isSecretReference Boolean  @default(false) @map("is_secret_reference")
  updatedBy         String?  @map("updated_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("app_settings")
}
