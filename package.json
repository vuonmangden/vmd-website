{
  "name": "vmd-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=24.0.0 <25", "pnpm": "11.9.0" },
  "devEngines": {
    "runtime": { "name": "node", "version": "24.14.0", "onFail": "error" }
  },
  "scripts": {
    "preinstall": "node scripts/require-node-24.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
