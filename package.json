{
  "name": "vmd-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/require-node-24.mjs",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint scripts/*.mjs infrastructure/docker/mocks/*.mjs",
    "lint:infra": "eslint scripts/*.mjs infrastructure/docker/mocks/*.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/*.test.mjs infrastructure/docker/mocks/*.test.mjs",
    "build": "turbo run build",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:status": "node scripts/infra.mjs status",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:check": "node scripts/infra.mjs check",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "ci:prisma": "node scripts/ci-prisma-check.mjs",
    "prepare": "husky",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "pg": "8.16.3",
    "prisma": "7.7.0",
    "tsx": "4.19.4",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "@playwright/test": "1.52.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  }
}
