# Browser-visible values. Only NEXT_PUBLIC_* may be referenced by web/admin client code.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001

# Server-only local shell values. Never prefix secrets or internal URLs with NEXT_PUBLIC_.
API_PORT=3002
WORKER_NAME=vmd-worker-local

# Comma-separated CORS allowlist. Empty means deny all cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase Auth. Server-only; the JWT secret verifies staff access tokens.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=local_only_fake_jwt_secret_replace_in_real_env

# Server-only local infrastructure. All credentials below are fake development values.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vmd_local
POSTGRES_USER=vmd_local
POSTGRES_PASSWORD=vmd_local_only_password
DATABASE_URL=postgresql://vmd_local:vmd_local_only_password@127.0.0.1:5432/vmd_local

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://127.0.0.1:8025

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=vmd-local
MINIO_ROOT_USER=vmd_local_minio
MINIO_ROOT_PASSWORD=vmd_local_minio_only_password

# Email adapter. "resend" hits the real provider; anything else uses the
# local log adapter, which is rejected when NODE_ENV=production.
EMAIL_PROVIDER=log
RESEND_API_KEY=local_only_fake_resend_key
NOTIFICATION_FROM_EMAIL=Vườn Măng Đen <noreply@vuonmangden.vn>
NOTIFICATION_REPLY_TO_EMAIL=info@vuonmangden.vn

MOCK_SEPAY_PORT=4010
SEPAY_API_BASE_URL=http://127.0.0.1:4010
MOCK_ZALO_PORT=4011
ZALO_API_BASE_URL=http://127.0.0.1:4011
