# Browser-visible values. Only NEXT_PUBLIC_* may be referenced by web/admin client code.
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001

# Server-only local shell values. Never prefix secrets or internal URLs with NEXT_PUBLIC_.
API_PORT=3002
WORKER_NAME=vmd-worker-local

# Security controls. Production requires an explicit HTTPS CORS allow-list; only explicitly trusted proxies may supply X-Forwarded-For.
APP_ENV=development
BOOKING_HOLD_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://staging.vuonmangden.com
TRUSTED_PROXY_IPS=
REQUEST_BODY_LIMIT=32kb

# Server-only local infrastructure. All credentials below are fake development values.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vmd_local
POSTGRES_USER=vmd_local
POSTGRES_PASSWORD=vmd_local_only_password
DATABASE_URL=postgresql://vmd_local:vmd_local_only_password@127.0.0.1:5432/vmd_local

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_UI_URL=http://127.0.0.1:8025

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=vmd-local
MINIO_ROOT_USER=vmd_local_minio
MINIO_ROOT_PASSWORD=vmd_local_minio_only_password

# Production object storage (CMS media). Fail-closed: APP_ENV=production alone
# is not enough, STORAGE_ENV=production must opt in as well, and every value
# below must be present and well-formed or media stays unavailable.
# Leave STORAGE_ENV unset for local development — the MINIO_* values above are used.
#
# Any S3-compatible provider works. Two that add no new vendor or cost at this scale:
#   Supabase Storage (this project already provisions Supabase):
#     STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#     STORAGE_REGION=<the project's region, e.g. ap-southeast-1>
#     keys from Dashboard > Storage > S3 Access Keys (separate from the anon/service keys)
#   Cloudflare R2:
#     STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     STORAGE_REGION=auto
#
# STORAGE_REGION must match the provider — the AWS SDK signs every request with
# it, so a wrong value fails signature verification rather than erroring clearly.
STORAGE_ENV=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
# Path-style by default (Supabase, R2, MinIO). Set to false only for real AWS S3.
STORAGE_FORCE_PATH_STYLE=

MOCK_SEPAY_PORT=4010
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_AUTH_TYPE=api_key
SEPAY_API_BASE_URL=http://127.0.0.1:4010
# Local fake API key. Production requires a distinct secret-manager value.
SEPAY_API_KEY=sepay_test_local_only
# Required only with APP_ENV=production and SEPAY_ENV=production. Never commit values.
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE_URL=https://vietqr.app/img
MOCK_ZALO_PORT=4011
ZALO_API_BASE_URL=http://127.0.0.1:4011
# Zalo is deliberately off the go-live critical path (NTF-009): with no Zalo
# Official Account registered, leaving this unset means no Zalo job is created
# at all, rather than one guaranteed failure per confirmed booking filling the
# staff failure inbox. Guests are unaffected — the email job is independent.
# Set to true only once an OA exists; production also still needs its own
# fail-closed gate lifted with a real ZNS contract, same as email needed.
ZALO_ENABLED=false

# Email delivery. Local/staging use Mailpit; production requires Resend.
# Fail-closed like storage and SePay: APP_ENV=production alone is not enough,
# EMAIL_ENV=production must opt in as well, the provider must be `resend`, and
# RESEND_API_KEY must be present — otherwise the worker refuses to send rather
# than dropping guest confirmations into a local mail catcher.
#
# EMAIL_FROM_ADDRESS must be on a domain verified in Resend (Domains > the
# domain shows Verified). Sending from an unverified domain is rejected by the
# provider, not by this config.
EMAIL_PROVIDER=mailpit
EMAIL_FROM_NAME=Vườn Măng Đen
EMAIL_FROM_ADDRESS=noreply@vuonmangden.com
EMAIL_REPLY_TO=info@vuonmangden.com
# Leave EMAIL_ENV unset outside production.
EMAIL_ENV=
RESEND_API_KEY=
# Optional overrides; defaults are https://api.resend.com and 10000ms.
RESEND_API_URL=
EMAIL_TIMEOUT_MS=

# Staff mailbox for internal payment-exception alerts (NTF-004). Optional —
# if unset, the alert is skipped rather than failing the payment webhook.
NOTIFICATION_INTERNAL_EMAIL=
